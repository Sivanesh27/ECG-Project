# ---- copy to .env (never commit .env) ----
ENV=development                      # development | production
MONGODB_URI=mongodb://localhost:27017   # Atlas: mongodb+srv://USER:PASS@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ecg_hrv

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"   (>= 32 chars required in production)
JWT_SECRET=CHANGE_ME_DEV_ONLY
SESSION_HOURS=8
REMEMBER_DAYS=30
COOKIE_SECURE=false                  # true behind HTTPS (production)
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Storage: local (dev) or s3 (any S3-compatible: AWS S3, Cloudflare R2, MinIO)
STORAGE_BACKEND=local
STORAGE_DIR=../storage
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

MAX_UPLOAD_MB=500
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_UPLOAD_PER_MIN=10
DEV_PRINT_RESET_LINKS=true           # no SMTP yet: prints password-reset links to the server console (dev only)
